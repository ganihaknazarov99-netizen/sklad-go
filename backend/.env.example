# Скопируйте в .env и задайте переменные окружения (или экспортируйте их в системе)
PORT=3000
# Файл базы данных SQLite (делайте его резервные копии!)
DB_PATH=./data/skladgo.db
# Подтверждение почты кодом из письма.
# false — для магазина: человек регистрируется, а пускает его владелец
#         кнопкой «Разрешить» на вкладке «Команда». Писем не нужно вовсе.
# true  — дополнительно требовать код из письма. Имеет смысл только когда
#         настроена настоящая отправка (MAIL_MODE=smtp), иначе никто
#         не сможет зарегистрироваться: код будет уходить в журнал сервера.
REQUIRE_VERIFY=false
# Почта: console (код печатается в логе сервера, для разработки)
#      | smtp    (обычный почтовый ящик — Gmail, Яндекс, почта своего домена)
#      | webhook (HTTP-служба рассылки, например Resend)
#
# Пока здесь console, «Забыли пароль?» не работает: код никуда не уйдёт.
# Пароль в этом случае сбрасывают с сервера: node scripts/admin.js password почта
MAIL_MODE=console

# ---- MAIL_MODE=smtp ----
# Gmail: SMTP_HOST=smtp.gmail.com, порт 587, SMTP_USER — ваш адрес,
# а SMTP_PASS — НЕ пароль от почты, а «пароль приложения»:
# включите двухэтапную проверку в аккаунте Google, затем
# myaccount.google.com/apppasswords — он выглядит как «abcd efgh ijkl mnop».
# Обычным паролем Google с 2022 года войти нельзя.
# Яндекс: smtp.yandex.ru, порт 465. Почта своего домена — спросите у хостинга.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Шифрование: обычно решает порт (465 — сразу, 587 — после STARTTLS).
# Пароль по нешифрованной линии программа не отправит никогда.
SMTP_SECURE=
# Только для своего почтового сервера с собственным сертификатом
SMTP_CA_FILE=

# ---- MAIL_MODE=webhook ----
# Например Resend (https://resend.com): POST https://api.resend.com/emails
MAIL_WEBHOOK_URL=
MAIL_API_KEY=
# Обратный адрес. Для Gmail оставьте пустым — подставится SMTP_USER
MAIL_FROM=
# Закрывает сервер. Если задано — завести свой магазин может только эта почта,
# остальные входят лишь по ссылке-приглашению владельца. Если пусто — любой,
# кто знает адрес, заведёт себе отдельный склад (так нужно для общего сервера).
# Каждый, кто регистрируется сам, становится владельцем СВОЕГО магазина.
OWNER_EMAIL=
# Откуда разрешены запросы, если сайт лежит на другом домене (иначе оставьте пустым)
CORS_ORIGIN=
# Срок жизни сессии (дней)
SESSION_DAYS=30
# Не включайте в продакшене: показывает отправленные письма по /api/dev/mailbox
DEV_MAILBOX=false

# ---- Если вход потерян ----
# Второй фактор защищает вход, но может и запереть: телефон утонул, запасные
# коды потеряны. Тогда с сервера:   node scripts/admin.js 2fa-off почта@пример
# Там же: password (новый пароль), codes (новые запасные коды), list (кто есть).
